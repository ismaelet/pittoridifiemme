# Ignore environment and configuration files
.env
.s3cfg

# Ignore database files
*.sql

# Ignore IDE settings
/.vscode/settings.json

# Ignore dependencies
/app/node_modules
/app/vendor

# Ignore build artifacts
/app/public/build
/app/public/hot

# Ignore storage files and the storage symlink
/app/public/storage
/app/storage/*
!/app/storage/**/
!/app/storage/**/.gitignore

# Ignore legacy files
/legacy
# Ignore published Filament assets (regenerated by `php artisan filament:upgrade`)
/app/public/css/filament
/app/public/js/filament
/app/public/fonts/filament
